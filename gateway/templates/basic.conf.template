server {
    listen 8080;
    server_name _;
    server_tokens off;

    auth_basic "Live Portal";
    auth_basic_user_file /etc/nginx/.htpasswd;

    location = /healthz {
        auth_basic off;
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /portal {
        return 301 /portal/;
    }

    location ^~ /portal/ {
        proxy_pass http://portal:8080/;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://portal:8080;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_buffering off;
    }
}
