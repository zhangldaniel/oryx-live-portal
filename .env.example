# 对外端口。浏览器默认访问 http://服务器IP:8086
PORT=8086

# 认证模式：basic 或 sso。
AUTH_MODE=basic

# Oryx 的 HTTP/HLS 地址，只填写协议、主机和端口，不要以 / 结尾。
HLS_UPSTREAM=http://192.168.1.20:2022

# Basic 模式使用的登录账号和密码。部署前必须修改。
BASIC_AUTH_USER=viewer
BASIC_AUTH_PASSWORD=change-me-to-a-long-random-password

# SSO 模式使用的 OIDC 配置。真实值只写入服务器 .env。
OIDC_ISSUER_URL=https://sso.example.com
OIDC_CLIENT_ID=oryx-live-portal
OIDC_CLIENT_SECRET=replace-with-real-client-secret
OIDC_REDIRECT_URL=https://live.example.com/oauth2/callback
OIDC_SCOPE=openid profile email groups

# 授权方式：group 或 email。
SSO_AUTHZ_MODE=group

# group 模式：PMP 用户组应同步进入该 OIDC Claim。
SSO_GROUPS_CLAIM=groups
SSO_ALLOWED_GROUPS=oryx-live-viewers

# email 模式：多个邮箱使用英文逗号分隔，不要添加空格。
# SSO_ALLOWED_EMAILS=viewer1@example.com,viewer2@example.com

# 使用 openssl rand -base64 32 生成，所有重启和副本必须保持一致。
SSO_COOKIE_SECRET=replace-with-a-32-byte-base64-secret
SSO_COOKIE_EXPIRE=8h
SSO_COOKIE_REFRESH=1h

# 如与现有 Docker 网络冲突，可以修改此网段。
PORTAL_NETWORK_CIDR=172.30.246.0/24

# 默认生成 stream01 到 stream10。
ROOM_COUNT=10
STREAM_PREFIX=stream

# 页面主标题。
PORTAL_TITLE=直播总览
