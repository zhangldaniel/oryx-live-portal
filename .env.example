# 对外端口
PORT=8086

# basic 或 sso
AUTH_MODE=basic

# Oryx HTTP/HLS 地址，不要以 / 结尾
HLS_UPSTREAM=http://192.168.1.20:2022

# Basic Auth
BASIC_AUTH_USER=viewer
BASIC_AUTH_PASSWORD=change-me-to-a-long-random-password

# OIDC SSO
OIDC_ISSUER_URL=https://sso.example.com
OIDC_CLIENT_ID=oryx-live-portal
OIDC_CLIENT_SECRET=replace-with-real-client-secret
OIDC_REDIRECT_URL=https://live.example.com/oauth2/callback
OIDC_SCOPE=openid profile email

# 使用 openssl rand -base64 32 分别生成
SSO_COOKIE_SECRET=replace-with-a-32-byte-base64-secret
AUTHZ_CSRF_SECRET=replace-with-another-32-byte-base64-secret
AUTHZ_GATEWAY_SECRET=replace-with-a-64-character-hex-secret
SSO_COOKIE_EXPIRE=8h
SSO_COOKIE_REFRESH=1h

# 动态观看权限
PORTAL_ADMIN_EMAILS=admin@example.com
PORTAL_INITIAL_VIEWERS=viewer1@example.com,viewer2@example.com
AUTHZ_ALLOWED_EMAIL_DOMAIN=example.com
AUTHZ_DATA_DIR=./data
AUTHZ_AUDIT_RETENTION_DAYS=90
AUTHZ_BACKUP_RETENTION_DAYS=30

# Docker 内部网络
PORTAL_NETWORK_CIDR=172.30.246.0/24

# 外层 HTTPS Nginx 的来源 IP/CIDR，用于可信客户端 IP 审计
PORTAL_TRUSTED_PROXY_CIDR=10.0.0.10/32

# 直播间
ROOM_COUNT=10
STREAM_PREFIX=stream
PORTAL_TITLE=直播总览
